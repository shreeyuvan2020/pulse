<?xml version="1.0" encoding="utf-8"?>
<!--
  Paste this into the SignPath project's artifact configuration (slug:
  initial). The release workflow uploads a zip holding pulse.exe; SignPath
  refuses to sign it unless the embedded product name and version match.
  Pass `version` as a parameter from the workflow (see release.yml).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="pulse.exe" product-name="Pulse" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
